APP_ENV=development
API_AUTH_TOKEN=
API_AUTH_ROLE=operator
API_AUTH_USER_ID=00000000-0000-0000-0000-000000000001
API_AUTH_PORTFOLIO_ID=00000000-0000-0000-0000-000000000002
DATABASE_URL=sqlite:///./sentinelalpha.db
REDIS_URL=
REDIS_REQUIRED=false
CACHE_TTL_SECONDS=30
WORKFLOW_LOCK_TTL_SECONDS=300
WORKFLOW_LOCK_WAIT_SECONDS=0
RUN_MIGRATIONS_ON_STARTUP=true
WEB_ORIGIN=http://localhost:3000

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_TRADING_API_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_FEED=iex
ALPACA_OPTIONS_FEED=indicative
ALPACA_OPTIONS_EXECUTION_ADAPTER=cli
ALPACA_CLI_PATH=alpaca

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

LIVE_TRADING_ENABLED=false
AUTO_EXECUTE_PAPER=false

MAX_SINGLE_POSITION_PCT=0.10
MAX_NEW_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.03
MAX_PORTFOLIO_DRAWDOWN_PCT=0.08
MIN_CONSUS_CONFIDENCE=0.70
MIN_AGREEING_AGENTS=3
MAX_TRADES_PER_DAY=10
MAX_DATA_AGE_SECONDS=120
MAX_VOLATILITY_ANNUALIZED=0.80
HEDGE_MIN_RISK_SCORE=0.55
HEDGE_RELEASE_RISK_SCORE=0.35
HEDGE_TARGET_DTE=30
HEDGE_MIN_DTE=21
HEDGE_MAX_DTE=45
HEDGE_TARGET_OTM_PCT=0.05
HEDGE_MAX_OTM_PCT=0.10
HEDGE_MAX_RATIO=1.00
HEDGE_MAX_PREMIUM_PCT=0.02
HEDGE_MAX_SPREAD_PCT=0.25
HEDGE_MAX_CONTRACTS=10
